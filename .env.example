SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RB_TENANT_SLUG=rb-distribuidora
RB_CATALOG_XLSX=data/RB_CATALOGO_MASTER.xlsx
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_TENANT_SLUG=rb-distribuidora
# Temporary per-deployment fallback. In production the public tenant is resolved
# from tenant_domains; the selected-tenant cookie is ignored by public pages.
ADMIN_PASSWORD=change-this-admin-password

# Supplier ingestion (server-side only; Google Sheet sharing must allow read/export)
VINROS_TENANT_SLUG=your-tenant-slug
VINROS_LIST_1_URL=https://docs.google.com/spreadsheets/d/1RfIul9S8Zuyd2H8BiYNd7oMDQtNL2NXm/edit?gid=1877280813#gid=1877280813
VINROS_LIST_2_URL=https://docs.google.com/spreadsheets/d/1RKu0ldsucFIk0fXCVh2KHSi1EVTPM7Gz/edit?gid=223050305#gid=223050305
VINROS_LIST_3_URL=https://docs.google.com/spreadsheets/d/1DdbZSzvLTgtLeTewwpwkjMT6OnTe0Dsb/edit?gid=364032974#gid=364032974
VINROS_LIST_4_URL=https://docs.google.com/spreadsheets/d/1QImDzrFNFFw7qjV8Z1GE5h-053EoDBkB/edit?gid=1011739089#gid=1011739089
# Runia Production baselines approved on 2026-08-13.
VINROS_LIST_1_BASELINE_ROWS=3230
VINROS_LIST_2_BASELINE_ROWS=3227
VINROS_LIST_3_BASELINE_ROWS=3228
VINROS_LIST_4_BASELINE_ROWS=3875
VINROS_MINIMUM_PRODUCTS_PER_LIST=10
VINROS_RUN_LEASE_SECONDS=1800
# Daily automation, server-only. Production uses GitHub Actions repository secrets.
VINROS_AUTOMATION_ENABLED=false
VINROS_ALERT_EMAIL_ENABLED=false
VINROS_ALERT_EMAIL_TO=operations@example.com
VINROS_ALERT_EMAIL_FROM=Runia <alerts@verified.example.com>
RESEND_API_KEY=replace-with-a-server-only-resend-key
# Optional VINROS-only absolute floors; no wine price floor exists in the generic core.
VINROS_RETAIL_MIN_PRICE=
VINROS_WHOLESALE_MIN_PRICE=
VINROS_BUSINESS_MIN_PRICE=
VINROS_COST_MIN_PRICE=

# Runia Dev isolated DB procedure. Never reuse production or Sommelier IA values.
# The secret key and database URL are server-side secrets; do not commit real values.
RUNIA_DEV_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
RUNIA_DEV_SUPABASE_SECRET_KEY=your-runia-dev-secret-key
RUNIA_DEV_PROJECT_REF=abcdefghijklmnopqrst
RUNIA_DEV_DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:password@host:6543/postgres?sslmode=require
RUNIA_DEV_TENANT_SLUG=your-explicit-dev-tenant
RUNIA_DEV_CONFIRM_ISOLATED=RUNIA_DEV_ONLY:abcdefghijklmnopqrst
# Optional hard deny-list (comma separated), recommended for production and Sommelier IA refs.
RUNIA_PROTECTED_PROJECT_REFS=
# Required only for the corresponding mutating phase.
RUNIA_DEV_CONFIRM_MIGRATION=APPLY_012_TO_RUNIA_DEV:abcdefghijklmnopqrst
RUNIA_DEV_CONFIRM_HARNESS=RUNIA_DEV_HARNESS:abcdefghijklmnopqrst
RUNIA_DEV_CONFIRM_FIRST_WRITE=WRITE_VINROS_TO_RUNIA_DEV:abcdefghijklmnopqrst:your-explicit-dev-tenant
RUNIA_DEV_CONFIRM_SECOND_WRITE=REPEAT_VINROS_IN_RUNIA_DEV:abcdefghijklmnopqrst:your-explicit-dev-tenant
